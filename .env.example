# Unofficial Grok Bot host gateway. Never commit real values.
# Copy to `.env` and fill in locally. The TUI never prints these.

# Gateway origin. Keep any path; only a trailing slash is trimmed.
GROKBOT_GATEWAY_URL=http://127.0.0.1:1340

# Gateway token. Treat like a password. Optional on macOS if the Grok Bot
# desktop app is signed in (Keychain "Grok Bot Safe Storage").
GROKBOT_GATEWAY_TOKEN=

# Optional: skip the picker and open this agent (name or id)
GROK_TUI_DEFAULT_AGENT=

# Optional: in-process mock host (no live Grok Bot). Same as `npm start -- --mock`
# GROK_TUI_MOCK=1

# Optional: how often to refresh the transcript while idle (ms). Default 1500.
# GROK_TUI_POLL_MS=1500

# Optional: max wait for a 1:1 reply (ms). Default 600000 (10 min). Esc cancels earlier.
# Set to 0 to wait until Esc with no timeout.
# GROK_TUI_WAIT_TIMEOUT_MS=600000

# Optional: localhost port when a token is set without GROKBOT_GATEWAY_URL (default 1340).
# GROKBOT_GATEWAY_PORT=1340
