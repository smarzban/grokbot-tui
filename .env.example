# Unofficial Grok Bot host gateway. Never commit real values.
# Copy to `.env` and fill in locally. The TUI never prints these.

# Full origin of the live host gateway (wins over gateway.json host/port).
GROKBOT_GATEWAY_URL=http://127.0.0.1:1340

# Alias accepted by @adam91holt/grokbot-sdk
# SAND_GATEWAY_URL=http://127.0.0.1:1340

# Alias accepted by grok-bot-cli
# GROK_BOT_GATEWAY_URL=http://127.0.0.1:1340

# Gateway token from the host's gateway.json. Treat like a password.
SAND_GATEWAY_TOKEN=

# Aliases
# GROK_BOT_GATEWAY_TOKEN=
# SAND_HOST_GATEWAY_TOKEN=

# Optional: skip the picker and open this agent (name or id)
GROK_TUI_DEFAULT_AGENT=

# Optional: in-process mock host (no live Grok Bot). Same as `npm start -- --mock`
# GROK_TUI_MOCK=1

# Optional: how often to refresh the transcript while idle (ms). Default 1500.
# GROK_TUI_POLL_MS=1500
